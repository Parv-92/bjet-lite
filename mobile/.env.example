# Bjet Mobile Environment Configuration

# ------------------------------------------------------------------------------
# DEVELOPMENT (Localhost with FastAPI backend):
# Default if EXPO_PUBLIC_API_BASE_URL is left unset in __DEV__ mode:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# (Requires: adb reverse tcp:8000 tcp:8000 when testing on physical Android devices)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# PRODUCTION (Required for standalone production builds):
# Must be a valid HTTPS URL. Localhost and 127.0.0.1 are strictly rejected.
# EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# LOCAL RELEASE TESTING (Physical Android testing of release APK with adb reverse):
# EXPO_PUBLIC_ALLOW_LOCAL_RELEASE=true
# ------------------------------------------------------------------------------
